{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://13.58.92.215:2375/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://13.58.92.215:2375/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://13.58.92.215:2375/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
