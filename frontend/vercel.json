{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://oh-01.vexanode.gg:4064/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://oh-01.vexanode.gg:4064/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://oh-01.vexanode.gg:4064/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}